rules_version = '2';

// Sovereign — Firestore security rules
// Deploy this via Firebase Console → Firestore Database → Rules tab
// (paste and Publish), or via `firebase deploy --only firestore:rules`
// if you set up the Firebase CLI. This file is NOT read by index.html —
// it has to be deployed to Firebase directly for data isolation to
// actually be enforced server-side.

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read/write their own document, keyed by their
    // own Google auth UID. No one can read or write anyone else's data,
    // signed in or not.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is denied by default (Firestore denies unless a
    // rule explicitly allows it, so no catch-all needed).
  }
}
